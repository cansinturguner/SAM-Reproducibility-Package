{
  "schema": "sam.phase9.tesla-delayed-auth.v1",
  "scope": {
    "implemented": "TESLA key chain, one-interval delayed B1 disclosure, buffering and loss simulation",
    "not_implemented": [
      "Phase Overlay RF waveform, RS FEC or BER",
